# Copy this file to .env (same folder) and fill in your values.
# .env is ignored by git, so your real secrets are never uploaded.

# json = local files in data/ (default)   supabase = cloud database
STORAGE=json

# Only needed when STORAGE=supabase (Supabase → Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-secret-service-role-key

# Password for the Streamlit app login screen
APP_PASSWORD=choose-a-strong-password
